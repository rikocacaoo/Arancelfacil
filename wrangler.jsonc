{
  "name": "arancelfacil",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Solo /api/* pasa por el Worker; el resto lo sirve Cloudflare directo
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GEMINI_MODEL": "gemini-flash-latest"
  }
}
